{
    "name": "PaperArxiv",
    "version": "0.2.0",
    "description": "A paper management tool",
    "main": "main.js",
    "type": "commonjs",
    "scripts": {
        "start": "electron .",
        "dev": "electron . --development",
        "test": "ava",
        "build": "electron-builder",
        "build:mac": "electron-builder --mac",
        "build:mac-arm64": "electron-builder --mac --arm64",
        "build:mac-x64": "electron-builder --mac --x64",
        "build:mac-universal": "electron-builder --mac --universal",
        "build:win": "electron-builder --win",
        "build:linux": "electron-builder --linux",
        "build:all": "electron-builder -mwl",
        "dist": "npm run build",
        "pack": "electron-builder --dir",
        "postinstall": "electron-builder install-app-deps",
        "clean": "./scripts/clean-build.sh",
        "rebuild": "npm run clean && npm run build",
        "debug:hdiutil": "hdiutil info",
        "debug:system": "system_profiler SPSoftwareDataType | grep 'System Version'"
    },
    "repository": "https://github.com/electron/electron-quick-start",
    "keywords": [
        "Electron",
        "quick",
        "start",
        "tutorial",
        "demo"
    ],
    "author": "Maple",
    "license": "MIT",
    "devDependencies": {
        "ava": "^6.1.3",
        "electron": "^33.4.11",
        "electron-builder": "^25.1.8"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "@electron/remote": "^2.1.2",
        "@element-plus/icons-vue": "^2.3.1",
        "@traptitech/markdown-it-katex": "^3.6.0",
        "@xmldom/xmldom": "^0.9.5",
        "better-sqlite3": "^11.6.0",
        "element-plus": "^2.9.1",
        "home-dir": "^1.0.0",
        "katex": "^0.16.18",
        "markdown-it": "^14.1.0",
        "mermaid": "^11.5.0",
        "ollama": "^0.5.10",
        "open": "^10.1.0",
        "split.js": "^1.6.5",
        "string-similarity": "^4.0.4",
        "title-case": "^4.3.2",
        "vue": "^3.5.13",
        "xpath": "^0.0.34"
    },
    "build": {
        "appId": "com.maple.paperarxiv",
        "productName": "PaperArxiv",
        "directories": {
            "output": "dist",
            "buildResources": "build"
        },
        "files": [
            "**/*",
            "!**/*.ts",
            "!*.code-workspace",
            "!LICENSE.md",
            "!package.json.md",
            "!.vscode",
            "!.gitignore",
            "!README.md",
            "!yarn.lock",
            "!.github",
            "!test",
            "!*.log"
        ],
        "mac": {
            "icon": "icons/pa.icns",
            "category": "public.app-category.productivity",
            "target": "dmg"
        },
        "dmg": {
            "format": "UDZO",
            "title": "${productName} ${version}",
            "writeUpdateInfo": false,
            "window": {
                "width": 540,
                "height": 380
            },
            "contents": [
                {
                    "x": 140,
                    "y": 200,
                    "type": "file"
                },
                {
                    "x": 400,
                    "y": 200,
                    "type": "link",
                    "path": "/Applications"
                }
            ]
        },
        "win": {
            "icon": "icons/pa.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "linux": {
            "icon": "icons/pa.png",
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "deb",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "rpm",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        },
        "publish": null
    }
}
